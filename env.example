# Backend real (deixe em branco para rodar em modo demo, 100% no navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Administrador MASTER — e-mails separados por vírgula.
# É o único perfil que administra QUALQUER campeonato e o único que pode
# EXCLUIR um campeonato (nem mesmo o dono pode). No Supabase, cadastre os
# mesmos e-mails na tabela `master_admins` (migration 0015) para valer também
# no banco (RLS).
VITE_MASTER_ADMINS=master@tabelaco.app

# Notificações push (Web Push/VAPID). Gere com: npx web-push generate-vapid-keys
# A chave PRIVADA fica só nos secrets da Edge Function `send-push`.
VITE_VAPID_PUBLIC_KEY=

# API de validação do atleta (opcional).
VITE_VALIDATION_URL=

# ---------------------------------------------------------------------------
# Pagamentos — Mercado Pago
# ---------------------------------------------------------------------------
# Links de pagamento dos planos (públicos, sem credencial). Já vêm preenchidos
# no código; defina aqui apenas se quiser trocar sem mexer no fonte.
VITE_MP_LINK_BRONZE=
VITE_MP_LINK_PRATA=
VITE_MP_LINK_OURO=

# Chave PÚBLICA do Mercado Pago (APP_USR-...). Só é necessária se um dia o
# checkout for feito dentro do app (Checkout Bricks/Transparente). Ela é
# pública por definição — pode ir no bundle do navegador.
VITE_MP_PUBLIC_KEY=

# E-mail de contato do plano Diamante (habilita o botão "Falar com a gente").
VITE_CONTACT_EMAIL=

# ⚠️ O ACCESS TOKEN de produção do Mercado Pago NÃO entra neste arquivo:
# tudo que começa com VITE_ vai para o navegador e ficaria exposto. Ele é
# secret de servidor — guarde nos secrets do Supabase:
#   supabase secrets set MP_ACCESS_TOKEN="APP_USR-..."
